# Daily News URL. Local Vite development uses the /news-agent/ proxy by default.
# Set this only when the Flask dashboard is deployed behind its own public URL.
# VITE_DAILY_NEWS_URL=https://news.example.com

# English-learning Streamlit URL. Local Vite development uses /english-learning/.
# VITE_ENGLISH_LEARNING_URL=https://english.example.com
