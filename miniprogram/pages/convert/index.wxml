<view class="page">
  <view class="card">
    <text class="label">转换方式</text>
    <view class="row wrap">
      <button
        wx:for="{{targets}}"
        wx:key="id"
        size="mini"
        class="{{target === item.id ? 'btn' : 'btn-secondary'}}"
        bindtap="selectTarget"
        data-id="{{item.id}}"
      >{{item.label}}</button>
    </view>
    <view class="hint mt">{{targetHint}}</view>

    <view class="mt">
      <button class="btn" bindtap="chooseFile">{{fileName || "选择文件"}}</button>
    </view>

    <view class="row">
      <button class="btn" bindtap="convert" disabled="{{busy || !filePath}}">{{busy ? "转换中…" : "开始转换"}}</button>
    </view>

    <view class="err" wx:if="{{error}}">{{error}}</view>

    <block wx:if="{{resultText}}">
      <view class="mt">
        <text class="label">结果文本</text>
        <textarea class="textarea" value="{{resultText}}" disabled maxlength="-1" />
        <view class="row">
          <button class="btn-secondary" size="mini" bindtap="copyResult">复制结果</button>
        </view>
      </view>
    </block>
  </view>
</view>
