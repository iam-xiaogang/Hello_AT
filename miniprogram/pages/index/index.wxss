.header {
  background: linear-gradient(90deg, #8b5cf6, #6366f1, #38bdf8);
  box-shadow: 0 4rpx 20rpx rgba(139, 92, 246, 0.35);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  box-sizing: content-box;
}

.menu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
}

.menu-icon {
  color: #ffffff;
  line-height: 1;
}

.header-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  max-width: 50%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.page {
  padding: 24rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.tool {
  width: calc(50% - 12rpx);
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 24rpx rgba(139, 92, 246, 0.1);
}

.tool:active {
  opacity: 0.8;
  transform: translateY(-4rpx);
}

.tool-chip {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(139, 92, 246, 0.25);
}

.tool-icon {
  font-size: 44rpx;
  line-height: 1;
}

.tool-name {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.tool-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}
