<view class="header" style="padding-top: {{statusBarHeight}}px;">
  <view
    class="header-inner"
    style="height: {{navBarHeight}}px; padding-right: {{capsuleSide}}px;"
  >
    <view
      class="menu-btn"
      style="width: {{menuBtnSize}}px; height: {{menuBtnSize}}px;"
      bindtap="openSidebar"
      aria-label="打开侧边栏"
    >
      <text class="menu-icon" style="font-size: {{menuBtnSize * 0.5}}px;">☰</text>
    </view>
    <view class="header-title">Toolbox 工具箱</view>
    <view class="menu-spacer" style="width: {{menuBtnSize}}px;"></view>
  </view>
</view>

<view class="page">
  <view class="grid">
    <view
      class="tool"
      wx:for="{{tools}}"
      wx:key="id"
      bindtap="openTool"
      data-url="{{item.url}}"
    >
      <view class="tool-chip" style="background: linear-gradient(135deg, {{item.color1}}, {{item.color2}});">
        <text class="tool-icon">{{item.icon}}</text>
      </view>
      <view class="tool-name">{{item.name}}</view>
      <view class="tool-desc">{{item.desc}}</view>
    </view>
  </view>
</view>

<sidebar visible="{{sidebarOpen}}" bind:close="closeSidebar" />
