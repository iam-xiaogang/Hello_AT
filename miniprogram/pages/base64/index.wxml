<view class="page">
  <view class="card">
    <text class="label">输入</text>
    <textarea class="textarea" value="{{input}}" bindinput="onInput" maxlength="-1" placeholder="文本或 Base64" />
  </view>
  <view class="card">
    <text class="label">结果</text>
    <textarea class="textarea" value="{{output}}" disabled maxlength="-1" />
    <view class="row">
      <button class="btn" size="mini" bindtap="encode">编码</button>
      <button class="btn-secondary" size="mini" bindtap="decode">解码</button>
      <button class="btn-secondary" size="mini" bindtap="copyOutput">复制结果</button>
    </view>
    <view class="err" wx:if="{{error}}">{{error}}</view>
  </view>
</view>
